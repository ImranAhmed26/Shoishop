# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/shoishop

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 (product/reel media uploads)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: CDN/CloudFront domain in front of the S3 bucket
CDN_BASE_URL=

# App
PORT=4000
NODE_ENV=development
# Origin of the deployed frontend, for CORS
CORS_ORIGIN=http://localhost:3000
# Public URL of this API, used to build links in emails
APP_URL=http://localhost:3000
# Public URL of the frontend, used for post-login redirects (e.g. Google OAuth)
FRONTEND_URL=http://localhost:3000

# Google OAuth (leave unset to disable "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Seed admin user (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@marketplace.local
SEED_ADMIN_PASSWORD=ChangeMe123!
